# Local dev: SQLite, just a file, zero setup - no server to install.
DATABASE_URL=sqlite+aiosqlite:///./milk_delivery.db

# When you move to Aiven Postgres later, comment the line above and
# uncomment this one instead (also uncomment asyncpg in requirements.txt):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS gateway - TextBee (turns an Android phone into an SMS gateway).
# Get these from the TextBee app after adding your device: textbee.dev
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id
# Country code prepended to phone numbers stored without one (India = +91)
DEFAULT_COUNTRY_CODE=+91

ENV=development
