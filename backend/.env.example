# Local dev: SQLite, just a file, zero setup - no server to install.
DATABASE_URL=sqlite+aiosqlite:///./milk_delivery.db

# When you move to Aiven Postgres later, comment the line above and
# uncomment this one instead (also uncomment asyncpg in requirements.txt):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP / SMS gateway (MSG91 example - swap for Twilio etc. if preferred)
SMS_GATEWAY_PROVIDER=msg91
SMS_GATEWAY_API_KEY=your_api_key_here
SMS_GATEWAY_SENDER_ID=MILKAP

OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

ENV=development
