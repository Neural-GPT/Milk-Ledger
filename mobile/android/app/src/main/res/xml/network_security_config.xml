<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain HTTP (not HTTPS) ONLY to localhost, so adb reverse can
    reach the dev backend. Remove this file (and the reference to it in
    AndroidManifest.xml) once the backend is deployed behind HTTPS -
    it should never ship in a production build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
